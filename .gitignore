*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
uploads/
temp/
tmp/

# 6. IDE & Code Editor Configurations
.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# 7. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. Testing & Coverage Outputs
coverage/
.nyc_output/
